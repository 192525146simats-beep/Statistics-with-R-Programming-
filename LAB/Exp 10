exam_data <- data.frame(
  name = c('Anastasia', 'Dima', 'Katherine', 'James', 'Emily', 'Michael', 'Matthew', 'Laura', 'Kevin', 'Jonas'),
  score = c(12.5, 9, 16.5, NA, 9, 20, 14.5, NA, 8, 19),
  attempts = c(1, 3, 2, 3, 2, 3, 1, 1, 2, 1),
  qualify = c('yes', 'no', 'yes', 'no', 'no', 'yes', 'yes', 'no', 'no', 'yes'),
  stringsAsFactors = FALSE
)
print(exam_data[, c("name", "score")])
exam_data$country <- c('US', 'USA', 'USA', 'USA', 'USA', 'USA', 'USA', 'USA', 'USA', 'USA')
new_student <- data.frame(name = 'Suresh', score = 15.5, attempts = 1, qualify = 'yes', country = 'India')
exam_data <- rbind(exam_data, new_student)
exam_data_sorted <- exam_data[order(exam_data$name, exam_data$score), ]
print(exam_data_sorted)
write.csv(exam_data, "exam_data.csv", row.names = FALSE)
